{
  "expo": {
    "name": "MarketPulse",
    "slug": "marketpulse-app",
    "scheme": "marketpulse",
    "android": {
      "usesCleartextTraffic": true
    },
    "ios": {
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true
        }
      }
    },
    "plugins": [
      "expo-notifications",
      "expo-web-browser",
      "@clerk/expo",
      "expo-secure-store"
    ]
  }
}
